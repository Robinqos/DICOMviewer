<Window x:Class="DICOMviewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DICOM Prehliadac - Zadanie 1" Height="800" Width="1200" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" Background="#F0F0F0">
            <Button x:Name="BtnOtvorit" Content="Otvorit DICOM subor" Width="150" Height="30" Margin="5" Click="BtnOtvorit_Click"/>
            <Button x:Name="BtnAnonymizovat" Content="Anonymizovat" Width="120" Height="30" Margin="5" Click="BtnAnonymizovat_Click" IsEnabled="False"/>
            <TextBlock x:Name="TxtSubor" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="Bold" Text="Ziadny subor nie je otvoreny"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Margin="10" BorderBrush="Gray" BorderThickness="1">
                <StackPanel Margin="10">
                    <TextBlock Text="PREHLAD" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="#2c3e50"/>

                    <GroupBox Header="PACIENT" Margin="0,0,0,10">
                        <StackPanel x:Name="PnlPacient" Margin="5"/>
                    </GroupBox>

                    <GroupBox Header="STUDIA" Margin="0,0,0,10">
                        <StackPanel x:Name="PnlStudia" Margin="5"/>
                    </GroupBox>

                    <GroupBox Header="SERIA" Margin="0,0,0,10">
                        <StackPanel x:Name="PnlSeria" Margin="5"/>
                    </GroupBox>

                    <GroupBox Header="SNIMKA" Margin="0,0,0,10">
                        <StackPanel x:Name="PnlSnimka" Margin="5"/>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="Black" BorderBrush="Gray" BorderThickness="1">
                    <Grid>
                        <Image x:Name="ObrazDisplej" Stretch="Uniform"/>
                        <TextBlock x:Name="TxtUpozornenie" Foreground="White" FontSize="18" FontWeight="Bold" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <StackPanel x:Name="PnlWindowing" Grid.Row="1" Margin="0,10,0,0" Background="#F8F9FA">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Stred (WC):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider Grid.Column="1" x:Name="SliderWC" Minimum="-2000" Maximum="3000" Value="40" ValueChanged="SliderOkno_ValueChanged"/>
                        <TextBlock Grid.Column="2" x:Name="TxtWC" Text="40" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Sirka (WW):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider Grid.Column="1" x:Name="SliderWW" Minimum="1" Maximum="5000" Value="400" ValueChanged="SliderOkno_ValueChanged"/>
                        <TextBlock Grid.Column="2" x:Name="TxtWW" Text="400" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>

                    <StackPanel x:Name="PnlPredvolby" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5" Visibility="Collapsed">
                        <Button Content="Makke tkaniva (WC:40, WW:400)" Margin="5" Padding="5" Click="BtnMakkeTkaniva_Click"/>
                        <Button Content="Kosti (WC:600, WW:1600)" Margin="5" Padding="5" Click="BtnKosti_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <GroupBox Grid.Row="2" Header="Zoznam vsetkych tagov" Margin="10">
            <DataGrid x:Name="TagDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="100"/>
                    <DataGridTextColumn Header="VR" Binding="{Binding VR}" Width="50"/>
                    <DataGridTextColumn Header="Nazov" Binding="{Binding Nazov}" Width="250"/>
                    <DataGridTextColumn Header="Hodnota" Binding="{Binding Hodnota}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>